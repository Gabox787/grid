EXCHANGE_ID=binance
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT

UPPER_BOUND=66000
LOWER_BOUND=60000
GRID_LEVELS=24

DEPOSIT_USDT=2000
CORE_USAGE_RATIO=0.6
EXTENSION_USAGE_RATIO=0.2
EXTENSION_DROP_PCT=0.15
EXTENSION_LEVELS=5

POLL_INTERVAL=10
DRY_RUN=true
PLACE_INITIAL_SELLS=true
FEE_RATE_PCT=0.001

# Порог простоя (сек) в DRY_RUN, после которого при рестарте сетка честно
# пересобирается у текущей цены вместо марафона фиктивных филлов. Не влияет на LIVE.
STALE_RESUME_THRESHOLD_SECONDS=1800

# Postgres для персистентности состояния и журнала сделок (например, Neon/Supabase free tier)
DATABASE_URL=

# Опционально: уведомления kill-switch + push по сделкам + команды управления в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
