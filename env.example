EXCHANGE_ID=binance
API_KEY=
API_SECRET=
SYMBOL=BTC/USDT

UPPER_BOUND=84000
LOWER_BOUND=70000
GRID_STEP_USD=600

DEPOSIT_USDT=2000
CAPITAL_USAGE_RATIO=0.8
EXTENSION_LEVELS=5

POLL_INTERVAL=10
DRY_RUN=true
PLACE_INITIAL_SELLS=true
FEE_RATE_PCT=0.001

# Порог простоя (сек) в DRY_RUN, после которого при рестарте сетка честно
# пересобирается у текущей цены вместо марафона фиктивных филлов. Не влияет на LIVE.
STALE_RESUME_THRESHOLD_SECONDS=1800

# Postgres для персистентности состояния и журнала сделок (например, Neon/Supabase free tier)
DATABASE_URL=

# Опционально: push по сделкам + команды управления + уведомления kill-switch в Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
